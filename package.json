{
    "name": "lairen-deck-builder",
    "description": "Demo App with Routing built-in (recommended)",
    "engines": {
        "node": "22.17.0"
    },
    "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
    "private": true,
    "trustedDependencies": [
        "sharp"
    ],
    "trustedDependencies-annotation": "Needed for bun to allow running install scripts",
    "type": "module",
    "scripts": {
        "build": "qwik build",
        "build.client": "vite build",
        "build.preview": "vite build --ssr src/entry.preview.tsx",
        "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
        "build.types": "tsc --incremental --noEmit",
        "deploy": "wrangler pages deploy ./dist",
        "dev": "vite --mode ssr --host | npx pino-pretty",
        "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
        "fmt": "prettier --write .",
        "fmt.check": "prettier --check .",
        "preview": "qwik build preview && vite preview --open",
        "serve": "wrangler pages dev ./dist --compatibility-flags=nodejs_als",
        "start": "vite --open --mode ssr",
        "qwik": "qwik",
        "supabase": "supabase"
    },
    "devDependencies": {
        "@builder.io/qwik": "1.19.0",
        "@builder.io/qwik-city": "1.19.0",
        "@eslint/js": "^10.0.1",
        "@fastify/compress": "^6.5.0",
        "@fastify/static": "^6.12.0",
        "@supabase/postgrest-js": "^1.21.4",
        "@types/eslint": "^9.6.1",
        "@types/he": "^1.2.3",
        "@types/node": "^20.19.27",
        "autoprefixer": "^10.4.23",
        "dotenv": "^16.6.1",
        "eslint": "9.26.0",
        "eslint-plugin-qwik": "^1.19.0",
        "fastify": "5.7.3",
        "fastify-plugin": "^4.5.1",
        "globals": "^17.3.0",
        "jose": "^6.1.3",
        "pino-pretty": "^11.3.0",
        "postcss": "^8.5.6",
        "postgres-js": "link:@types/@supabase/postgres-js",
        "postgrest-js": "link:@types/@supabase/postgrest-js",
        "prettier": "^3.7.4",
        "prettier-plugin-tailwindcss": "^0.5.14",
        "sass": "^1.97.0",
        "supabase": "^2.67.1",
        "tailwindcss": "3.3.3",
        "type-fest": "^5.3.1",
        "typed-inject": "^5.0.0",
        "typescript": "5.3.3",
        "typescript-eslint": "^8.56.0",
        "undici": "7.18.2",
        "vite": "^7.3.1",
        "vite-plugin-inspect": "0.8.4",
        "vite-tsconfig-paths": "^4.3.2",
        "wrangler": "4.59.1"
    },
    "dependencies": {
        "@qwik-ui/headless": "^0.3.8",
        "@supabase/ssr": "^0.8.0",
        "@supabase/supabase-js": "^2.97.0",
        "await-on": "^0.1.4",
        "chart.js": "^4.5.1",
        "he": "^1.2.0",
        "piexifjs": "^1.0.6",
        "pino": "^9.14.0",
        "png-metadata": "^1.0.2",
        "remix-params-helper": "^0.5.1",
        "zod": "^3.25.76"
    },
    "packageManager": "pnpm@9.15.3+sha512.1f79bc245a66eb0b07c5d4d83131240774642caaa86ef7d0434ab47c0d16f66b04e21e0c086eb61e62c77efc4d7f7ec071afad3796af64892fae66509173893a"
}
